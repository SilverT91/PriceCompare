{
  "name": "price-compare",
  "version": "0.1.0",
  "private": true,
  "description": "Local price comparison across shops with a branch in your city and web shops that deliver to Slovakia.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/node/server.ts",
    "search": "node src/node/cli.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fixtures": "node tools/extract_fixtures.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "cheerio": "1.2.0",
    "hono": "4.13.17",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  }
}
