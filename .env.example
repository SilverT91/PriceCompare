# Copy to .env (git-ignored) and fill in what you have. Never commit .env.

# Web search, used for shops whose own search page robots.txt disallows (or that have none).
# Any one key is enough; with several, SEARCH_PROVIDERS sets the order (the first is used, the next
# one takes over when the first runs out of credit or rejects the key). Default: brave,serper,tavily.
SERPER_API_KEY=
BRAVE_API_KEY=
# Tavily: a free monthly allowance (1,000 credits), no payment card needed.
TAVILY_API_KEY=
# SEARCH_PROVIDERS=brave,serper,tavily
# Results per query: Serper 10 = 1 credit, 11-100 = 2 credits; Brave max 20; Tavily max 20, 1 credit per search.
# SERPER_RESULTS=10
# BRAVE_RESULTS=20
# TAVILY_RESULTS=20
# Free allowances for the credit bars on the page (the defaults below); the providers' offers change,
# so set your plan's numbers here when they differ.
# BRAVE_MONTHLY_LIMIT=1000
# SERPER_TOTAL_LIMIT=2500
# TAVILY_MONTHLY_LIMIT=1000

# Local server port (binds to 127.0.0.1 only).
# PORT=8787
# SQLite file (default .cache/price-compare.sqlite).
# PRICE_COMPARE_DB=
