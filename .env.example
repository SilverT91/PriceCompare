# Copy to .env (git-ignored) and fill in what you have. Never commit .env.

# Web search, used for shops whose own search page robots.txt disallows (or that have none).
# Either key is enough; with both, SEARCH_PROVIDERS sets the order (the first is used, the next one
# takes over when the first runs out of credit or rejects the key).
SERPER_API_KEY=
BRAVE_API_KEY=
# SEARCH_PROVIDERS=serper,brave
# Results per query: Serper 10 = 1 credit, 11-100 = 2 credits; Brave max 20.
# SERPER_RESULTS=10
# BRAVE_RESULTS=20

# Local server port (binds to 127.0.0.1 only).
# PORT=8787
# SQLite file (default .cache/price-compare.sqlite).
# PRICE_COMPARE_DB=
